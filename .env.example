# Copy to .env and export these (or use your host's secret manager). Never commit real values.
PORT=3000
HOST=0.0.0.0

# Set to true only when running behind a reverse proxy you control (Nginx, Caddy, Cloudflare...)
TRUST_PROXY=false

# Comma-separated list of allowed browser origins for the signaling socket.
# Empty = same-origin only (Origin host must equal Host header).
ALLOWED_ORIGINS=

# Pairing
PAIRING_CODE_TTL_SECONDS=300
PAIRED_SESSION_MAX_SECONDS=7200
MAX_SESSIONS=5000
MAX_CONNECTIONS_PER_IP=20

# Optional built-in HTTPS (needed on phones for streaming-to-disk receive; see README)
TLS_KEY_FILE=
TLS_CERT_FILE=

# ICE servers handed to browsers through signaling (not hard-coded in the frontend)
STUN_URLS=stun:stun.l.google.com:19302
# TURN relay for networks where direct WebRTC fails. Pick ONE credential style:
TURN_URLS=
# a) coturn "use-auth-secret" (recommended: short-lived credentials)
TURN_SECRET=
TURN_TTL_SECONDS=3600
# b) static long-term credentials
TURN_USERNAME=
TURN_CREDENTIAL=
